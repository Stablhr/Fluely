# Server
PORT=5000/8080
NODE_ENV=development/production

# Auth - node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=


# Database
MONGO_URI=

#Email info 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookies
COOKIE_SECURE=false/true
COOKIE_SAMESITE=strict

# Seed Admin (used with `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Rate limiting (set to "false" to disable, e.g. during local testing)
RATE_LIMIT_ENABLED=true

# Media uploads (local disk by default; git-ignored)
MEDIA_UPLOAD_DIR=uploads
MEDIA_MAX_FILE_SIZE_MB=50
MEDIA_QUOTA_MB=500
# Comma-separated allow-list
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,audio/mpeg,audio/ogg,audio/wav,application/pdf,text/plain