# Server
PORT=5000/8080
NODE_ENV=development/production

# Auth - node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Rolling session length in days. The refresh token is reissued on every
# refresh, so an active account is never signed out; only an account idle for
# this long has to sign in again. A large value effectively means "stay signed
# in until logout". Defaults to 30 when unset.
REFRESH_TOKEN_TTL_DAYS=30


# Database
MONGO_URI=

#Email info 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookies
COOKIE_SECURE=false/true
COOKIE_SAMESITE=strict

# Seed Admin (used with `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Rate limiting (set to "false" to disable, e.g. during local testing)
RATE_LIMIT_ENABLED=true

# Media uploads (stored on Cloudinary — nothing is written to local disk)
MEDIA_MAX_FILE_SIZE_MB=500
MEDIA_QUOTA_MB=2048
# Comma-separated allow-list
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif,image/heic,image/svg+xml,video/mp4,video/webm,video/quicktime,video/x-m4v,video/3gpp,video/mpeg,video/ogg,audio/mpeg,audio/ogg,audio/wav,audio/mp4,application/pdf,text/plain

# Cloudinary (required for uploads). Find these on the API Keys page of your
# Cloudinary dashboard. `CLOUDINARY_FOLDER` is optional and defaults to "fluely".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fluely

# Done-card cleanup cron (GET /api/cron/cleanup-done-cards, scheduled in vercel.json).
# When CRON_SECRET is set the endpoint requires `Authorization: Bearer <CRON_SECRET>`,
# which Vercel sends automatically. Retention defaults to 2 days.
CRON_SECRET=
DONE_CARD_RETENTION_DAYS=2

# Optional. Comma-separated origins allowed to call the API with cookies
# (defaults to http://localhost:3000 and the production site).
# CORS_ORIGINS=http://localhost:3000
# Optional. Base URL used in emails (password reset, invitations).
# FRONTEND_URL=http://localhost:3000
# Optional. Prefix for the auth cookie names (default "dc"). Browsers share
# cookies across all ports of localhost, so if another local app uses the same
# names, set a unique prefix here to stop the two apps signing each other out.
# COOKIE_PREFIX=dc

# ── Social scheduling (see docs/SOCIAL_SCHEDULING_SETUP.md) ───────────
# This backend's public URL; OAuth redirect URIs and QStash deliveries use it.
API_PUBLIC_URL=http://localhost:5001
# 32 random bytes, base64. Encrypts stored platform tokens. Never change it
# once accounts are connected.
SOCIAL_TOKEN_KEY=
# Per platform: live | dryrun | disabled (default dryrun).
INSTAGRAM_MODE=dryrun
FACEBOOK_MODE=dryrun
TIKTOK_MODE=dryrun
YOUTUBE_MODE=dryrun
LINKEDIN_MODE=dryrun
# Meta app (Facebook Pages + Instagram)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0
# Optional: Facebook Login for Business configuration ids (used instead of a permission list)
# META_LOGIN_CONFIG_ID=
# META_INSTAGRAM_CONFIG_ID=
# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY
# Google (YouTube)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORGANIZATIONS=false
# Optional: pin LinkedIn's API version (YYYYMM). Unset = a recent one automatically.
# LINKEDIN_API_VERSION=
# Upstash QStash (exact-time delivery). Without a token the local server
# checks for due posts every 30 seconds instead.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Instagram Login (accounts not linked to Facebook)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# true once the Meta app has instagram_basic + instagram_content_publish (Facebook sign-in then also connects linked Instagram)
META_FACEBOOK_INCLUDES_INSTAGRAM=false
# Newer Meta apps: Instagram "Unified login" configuration ID (replaces the Instagram app ID/secret)
META_INSTAGRAM_UNIFIED_CONFIG_ID=
