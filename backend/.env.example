# Server
PORT=5000/8080
NODE_ENV=development/production

# Auth - node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Rolling session length in days. The refresh token is reissued on every
# refresh, so an active account is never signed out; only an account idle for
# this long has to sign in again. A large value effectively means "stay signed
# in until logout". Defaults to 30 when unset.
REFRESH_TOKEN_TTL_DAYS=30


# Database
MONGO_URI=

#Email info 
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cookies
COOKIE_SECURE=false/true
COOKIE_SAMESITE=strict

# Seed Admin (used with `npm run seed:admin`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User

# Rate limiting (set to "false" to disable, e.g. during local testing)
RATE_LIMIT_ENABLED=true

# Media uploads (stored on Cloudinary — nothing is written to local disk)
MEDIA_MAX_FILE_SIZE_MB=500
MEDIA_QUOTA_MB=2048
# Comma-separated allow-list
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,image/webp,image/avif,image/heic,image/svg+xml,video/mp4,video/webm,video/quicktime,video/x-m4v,video/3gpp,video/mpeg,video/ogg,audio/mpeg,audio/ogg,audio/wav,audio/mp4,application/pdf,text/plain

# Cloudinary (required for uploads). Find these on the API Keys page of your
# Cloudinary dashboard. `CLOUDINARY_FOLDER` is optional and defaults to "fluely".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fluely