{
  "version": 2,
  "builds": [
    {
      "src": "index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-done-cards",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/publish-due",
      "schedule": "15 4 * * *"
    }
  ]
}
